import React,{useEffect,useMemo,useState}from'react';
import{Dialog,DialogContent,DialogHeader,DialogTitle}from'@/components/ui/dialog';
import{Button}from'@/components/ui/button';
import{Input}from'@/components/ui/input';
import{Label}from'@/components/ui/label';
import{Select,SelectContent,SelectItem,SelectTrigger,SelectValue}from'@/components/ui/select';
import{Textarea}from'@/components/ui/textarea';
import{base44}from'@/api/base44Client';
import{useToast}from'@/components/ui/use-toast';
import{Loader2,Send}from'lucide-react';
const metasFallback=[['MC3A-01','Meta 1: Gestao e equipe'],['MC3A-02','Meta 2: Comunicacao'],['MC3A-03','Meta 3: Manutencao'],['MC3A-04','Meta 4: Nucleos expositivos'],['MC3A-05','Meta 5: Acoes educativas'],['MC3A-06','Meta 6: Acoes culturais'],['MC3A-07','Meta 7: Educadores'],['MC3A-08','Meta 8: MHAB Casarao'],['MC3A-09','Meta 9: Mostras e exposicoes'],['MC3A-10','Meta 10: Noturno nos Museus'],['MC3A-11','Meta 11: Publicacoes'],['MC3A-12','Meta 12: Alimentacao e materiais'],['MC3A-13','Meta 13: Consultorias'],['MC3A-CUSTOS-GERAIS','Meta Custos Gerais']];
const centros=['MHAB','MIS','MUMO','Atuacao Geral','Geral','Noturno nos Museus 2026','Publicacoes'];
const nrm=v=>String(v||'').normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase().replace(/[^a-z0-9]+/g,' ').trim();
const num=v=>{const s=String(v||'0').replace(/\s/g,'');if(/^\d{1,3}(\.\d{3})*(,\d+)?$/.test(s))return Number(s.replace(/\./g,'').replace(',','.'))||0;return Number(s.replace(',','.'))||0};
const clean=v=>String(v||'').normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/[^a-zA-Z0-9\s\-]/g,' ').replace(/\s+/g,' ').trim().toUpperCase();
function parseName(name){const b=String(name||'').replace(/\.(pdf|xml)$/i,'').trim();const m=b.match(/^\s*\d{2}\s+NF\s+([^\s]+)\s+(.+?)\s+-\s+(.+?)\s+-\s+MUSEUS\s+CENTRO\s+-\s+R?\$?\s*([\d.]+,\d{2}|\d+(?:,\d{2})?)\s*$/i);return m?{nf_numero:m[1],descricao_servico:clean(m[2]),nf_emitente_nome:clean(m[3]),nf_valor_total:m[4]}:{}}
function meta(t){t=nrm(t);if(t.includes('noturno'))return'MC3A-10';if(t.includes('publica')||t.includes('impress'))return'MC3A-11';if(t.includes('aliment')||t.includes('lanche')||t.includes('material'))return'MC3A-12';if(t.includes('consult'))return'MC3A-13';if(t.includes('transporte')||t.includes('contador')||t.includes('energia')||t.includes('jurid'))return'MC3A-CUSTOS-GERAIS';if(t.includes('educador'))return'MC3A-07';if(t.includes('mostra')||t.includes('expos'))return'MC3A-09';if(t.includes('comunic')||t.includes('designer')||t.includes('fotografo'))return'MC3A-02';return'MC3A-01'}
function score(r,t){t=nrm(t);const nome=nrm([r?.grupo,r?.rubrica,r?.nome,r?.descricao].filter(Boolean).join(' '));let s=0;t.split(' ').filter(p=>p.length>3).forEach(p=>{if(nome.includes(p))s+=2});if(t.includes('analista administrativo financeiro')&&nome.includes('analista')&&nome.includes('financeira'))s+=80;return s}
function bestRubrica(list,t){let b=null,bs=0;(list||[]).forEach(r=>{const s=score(r,t);if(s>bs){b=r;bs=s}});return bs>0?b:null}
const museuRubrica=r=>{const t=nrm([r?.museu_codigo,r?.museu,r?.centro_custo,r?.rubrica,r?.nome,r?.grupo].filter(Boolean).join(' '));if(/\bmis\b/.test(t)||t.includes('imagem')||t.includes('som'))return'MIS';if(/\bmumo\b/.test(t)||t.includes('moda'))return'MUMO';if(/\bmhab\b/.test(t)||/\bmab\b/.test(t)||t.includes('abilio')||t.includes('historico'))return'MHAB';if(t.includes('noturno'))return'NOTURNO';return''};
const metaRubrica=r=>r?.meta||r?.rubrica_meta||r?.meta_id||'';
const noturnoRubrica=r=>nrm(r?.escopo_orcamentario||'').includes('noturno')||nrm([r?.meta,r?.grupo,r?.rubrica,r?.nome].filter(Boolean).join(' ')).includes('noturno');
export default function ReviewModalNFStable({intake,onClose,onSaved}){const{toast}=useToast();const ia=intake?.resultado_ia||{};const p=parseName(intake?.file_name_final||intake?.file_name_original);const[rs,setRs]=useState([]);const[ms,setMs]=useState([]);const[busy,setBusy]=useState(false);const[f,setF]=useState(()=>{const txt=[intake?.file_name_final,intake?.file_name_original,ia.descricao_servico,ia.rubrica_nome_sugerida].join(' ');return{nf_numero:ia.nf_numero||p.nf_numero||'',nf_valor_total:ia.nf_valor_total||p.nf_valor_total||'',nf_emitente_nome:ia.nf_emitente_nome||p.nf_emitente_nome||'',nf_emitente_cpf_cnpj:ia.nf_emitente_cpf_cnpj||'',descricao_servico:ia.descricao_servico||p.descricao_servico||'',centro_custo:ia.centro_custo_sugerido||intake?.centro_custo||'Atuacao Geral',rubrica_id:intake?.rubrica_id_sugerida||ia.rubrica_id||'',meta_id:ia.meta_sugerida||ia.meta_id||meta(txt),tipo_gasto:ia.tipo_gasto||'Serviço'}});useEffect(()=>{base44.entities.Rubrica.list('',2000).then(l=>{l=(Array.isArray(l)?l:[]).filter(r=>r?.ativo!==false);setRs(l);setMs(Array.from(new Set(l.map(metaRubrica).filter(Boolean))).map(m=>[m,m]));const txt=[f.descricao_servico,intake?.file_name_final,intake?.file_name_original,ia.rubrica_nome_sugerida].join(' ');const r=bestRubrica(l,txt);if(r)setF(x=>({...x,rubrica_id:x.rubrica_id||r.id,meta_id:metaRubrica(r)||x.meta_id,centro_custo:museuRubrica(r)||x.centro_custo}))}).catch(()=>{})},[]);const file=useMemo(()=>`01 NF ${clean(f.nf_numero)||'SEM NUM'} ${clean(f.descricao_servico)||'NOTA FISCAL'} - ${clean(f.nf_emitente_nome)||'FORNECEDOR'} - MUSEUS CENTRO - ${num(f.nf_valor_total).toLocaleString('pt-BR',{minimumFractionDigits:2,maximumFractionDigits:2})}.pdf`,[f]);const set=(k,v)=>setF(x=>({...x,[k]:v}));async function enviar(){if(busy)return;const valor=num(f.nf_valor_total);if(!f.rubrica_id)return toast({title:'Rubrica obrigatoria',variant:'destructive'});if(!valor)return toast({title:'Valor invalido',variant:'destructive'});setBusy(true);try{const r=rs.find(x=>x.id===f.rubrica_id);const rn=r?.rubrica||r?.nome||r?.descricao||'';const metaFinal=metaRubrica(r)||f.meta_id;const centroFinal=museuRubrica(r)||f.centro_custo;const pr=await base44.entities.PurchaseRequest.create({descricao_item:f.descricao_servico||`NF ${f.nf_numero}`,fornecedor_nome:f.nf_emitente_nome,fornecedor_cnpj:f.nf_emitente_cpf_cnpj,valor_solicitado:valor,valor_total:valor,nf_valor_total:valor,rubrica_id:f.rubrica_id,rubrica_nome:rn,budgetline_id:f.rubrica_id,centro_custo:centroFinal,museu_codigo:museuRubrica(r),escopo_orcamentario:r?.escopo_orcamentario||'',rubrica_meta:metaFinal,rubrica_codigo:r?.codigo||'',status:'SOLICITADO',meta_id:metaFinal,categoria:'Nota Fiscal',tipo_gasto:f.tipo_gasto,nf_numero:f.nf_numero,observacoes:`Origem: EntradaUnica | intake_id: ${intake.id}`});const at=await base44.entities.Attachment.create({purchase_request_id:pr.id,file_name:file,file_type:intake?.mime_type||'application/pdf',file_url:intake?.arquivo_original_url||'',description:'Entrada Unica - Nota Fiscal',nf_categoria:'nota_fiscal',nf_numero:f.nf_numero,nf_valor_total:valor,nf_emitente_nome:f.nf_emitente_nome,nf_emitente_cpf_cnpj:f.nf_emitente_cpf_cnpj,nf_tipo_documento:'pdf_nf',nf_nome_original:intake?.file_name_original||'',nf_nome_renomeado:file,nf_revisado:true,rubrica_id:f.rubrica_id,rubrica_nome:rn});await base44.entities.DocumentIntake.update(intake.id,{status_processamento:'ENVIADO_APROVACAO',ocultar_entrada_unica:true,entidade_destino:'PurchaseRequest',entidade_destino_id:pr.id,attachment_id:at?.id||'',centro_custo:centroFinal,museu_codigo:museuRubrica(r),escopo_orcamentario:r?.escopo_orcamentario||'',rubrica_id_sugerida:f.rubrica_id,rubrica_nome_sugerida:rn,file_name_final:file,revisado_pelo_usuario:true,resultado_ia:{...ia,...f,purchase_request_id:pr.id,attachment_id:at?.id||'',file_name_final:file}});toast({title:'Enviado para aprovacao',description:'Solicitacao criada em Compras.'});await onSaved?.();onClose?.()}catch(e){toast({title:'Erro ao enviar',description:e?.message||'Falha ao criar solicitacao',variant:'destructive'})}finally{setBusy(false)}}return <Dialog open onOpenChange={onClose}><DialogContent className='max-w-2xl max-h-[90vh] overflow-y-auto'><DialogHeader><DialogTitle>Conferencia de Nota Fiscal</DialogTitle></DialogHeader><div className='space-y-4'><Input value={file} readOnly/><div className='grid grid-cols-2 gap-3'><div><Label>Numero NF</Label><Input value={f.nf_numero} onChange={e=>set('nf_numero',e.target.value)}/></div><div><Label>Valor</Label><Input value={f.nf_valor_total} onChange={e=>set('nf_valor_total',e.target.value)}/></div></div><div><Label>Fornecedor</Label><Input value={f.nf_emitente_nome} onChange={e=>set('nf_emitente_nome',e.target.value)}/></div><div><Label>Descricao</Label><Textarea value={f.descricao_servico} onChange={e=>set('descricao_servico',e.target.value)}/></div><div><Label>Meta do 3 Aditivo</Label><Select value={f.meta_id} onValueChange={v=>set('meta_id',v)}><SelectTrigger><SelectValue/></SelectTrigger><SelectContent>{(ms.length?ms:metasFallback).map(([id,n])=><SelectItem key={id} value={id}>{n}</SelectItem>)}</SelectContent></Select></div><div><Label>Centro</Label><Select value={f.centro_custo} onValueChange={v=>set('centro_custo',v)}><SelectTrigger><SelectValue/></SelectTrigger><SelectContent>{centros.map(c=><SelectItem key={c} value={c}>{c}</SelectItem>)}</SelectContent></Select></div><div><Label>Rubrica</Label><Select value={f.rubrica_id} onValueChange={v=>{const r=rs.find(x=>x.id===v);setF(x=>({...x,rubrica_id:v,meta_id:metaRubrica(r)||x.meta_id,centro_custo:museuRubrica(r)||x.centro_custo}))}}><SelectTrigger><SelectValue placeholder='Selecionar rubrica'/></SelectTrigger><SelectContent>{rs.filter(r=>(!f.meta_id||!metaRubrica(r)||metaRubrica(r)===f.meta_id)&&(!['MIS','MUMO','MHAB'].includes(f.centro_custo)||!museuRubrica(r)||museuRubrica(r)===f.centro_custo)&&(f.centro_custo!=='Noturno nos Museus 2026'||noturnoRubrica(r))).map(r=><SelectItem key={r.id} value={r.id}>{(r.grupo?`${r.grupo} - `:'')}{r.rubrica||r.nome||r.descricao||'Rubrica'}</SelectItem>)}</SelectContent></Select></div><div className='flex justify-end gap-2'><Button variant='outline' onClick={onClose}>Cancelar</Button><Button onClick={enviar} disabled={busy}>{busy?<Loader2 className='w-4 h-4 mr-2 animate-spin'/>:<Send className='w-4 h-4 mr-2'/>}Enviar para aprovacao</Button></div></div></DialogContent></Dialog>}
