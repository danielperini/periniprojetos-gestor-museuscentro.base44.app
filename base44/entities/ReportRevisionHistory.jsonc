{
  "name": "ReportRevisionHistory",
  "type": "object",
  "properties": {
    "revision_id": {
      "type": "string",
      "description": "ID da revis\u00e3o (FK \u2192 ReportRevision)"
    },
    "usuario_email": {
      "type": "string",
      "description": "Email do usu\u00e1rio que fez a altera\u00e7\u00e3o"
    },
    "usuario_nome": {
      "type": "string",
      "description": "Nome do usu\u00e1rio"
    },
    "tipo_alteracao": {
      "type": "string",
      "enum": [
        "TEXTO_EDITADO",
        "IMAGEM_SUBSTITUIDA",
        "LEGENDA_EDITADA",
        "SECAO_REGENERADA",
        "TEXTO_RESTAURADO",
        "STATUS_ALTERADO"
      ],
      "description": "Tipo de altera\u00e7\u00e3o realizada"
    },
    "secao": {
      "type": "string",
      "description": "Se\u00e7\u00e3o afetada (introducao, agenda, atividades, etc)"
    },
    "indice_imagem": {
      "type": "number",
      "description": "\u00cdndice da imagem (se aplic\u00e1vel)"
    },
    "conteudo_original": {
      "type": "string",
      "description": "Texto ou URL original"
    },
    "conteudo_novo": {
      "type": "string",
      "description": "Texto ou URL ap\u00f3s edi\u00e7\u00e3o"
    },
    "data_alteracao": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora da altera\u00e7\u00e3o"
    },
    "justificativa": {
      "type": "string",
      "description": "Justificativa da altera\u00e7\u00e3o (opcional)"
    },
    "acao_permitida": {
      "type": "boolean",
      "default": true,
      "description": "Se a altera\u00e7\u00e3o foi permitida (valida\u00e7\u00e3o)"
    },
    "motivo_rejeicao": {
      "type": "string",
      "description": "Motivo se a altera\u00e7\u00e3o foi rejeitada"
    }
  },
  "required": [
    "revision_id",
    "usuario_email",
    "tipo_alteracao",
    "secao"
  ]
}