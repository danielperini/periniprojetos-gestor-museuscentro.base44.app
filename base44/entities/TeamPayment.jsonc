{
  "name": "TeamPayment",
  "type": "object",
  "properties": {
    "team_member_id": {
      "type": "string",
      "description": "ID do membro da equipe (FK → TeamMember)"
    },
    "user_email": {
      "type": "string",
      "description": "Email do usuário (desnormalizado para queries)"
    },
    "user_name": {
      "type": "string",
      "description": "Nome do usuário/membro da equipe"
    },
    "funcao": {
      "type": "string",
      "description": "Função/cargo do membro no período do envio"
    },
    "role": {
      "type": "string",
      "description": "Campo legado/espelho da função para compatibilidade"
    },
    "report_id": {
      "type": "string",
      "description": "ID do relatório mensal aprovado vinculado (FK → Report)"
    },
    "mes_referencia": {
      "type": "string",
      "enum": [
        "Janeiro",
        "Fevereiro",
        "Março",
        "Abril",
        "Maio",
        "Junho",
        "Julho",
        "Agosto",
        "Setembro",
        "Outubro",
        "Novembro",
        "Dezembro"
      ],
      "description": "Mês referência"
    },
    "ano": {
      "type": "number",
      "description": "Ano referência"
    },
    "rubrica_id": {
      "type": "string",
      "description": "ID da rubrica vinculada ao pagamento. Fonte da verdade orçamentária."
    },
    "rubrica_nome": {
      "type": "string",
      "description": "Nome da rubrica vinculada ao pagamento"
    },
    "nota_fiscal_url": {
      "type": "string",
      "description": "URL da nota fiscal em PDF"
    },
    "nota_fiscal_file_name": {
      "type": "string",
      "description": "Nome final do arquivo PDF da nota fiscal"
    },
    "xml_url": {
      "type": "string",
      "description": "URL do XML da nota fiscal"
    },
    "xml_file_name": {
      "type": "string",
      "description": "Nome final do arquivo XML da nota fiscal"
    },
    "xlsx_url": {
      "type": "string",
      "description": "URL do arquivo XLSX (planilha de conferência)"
    },
    "contract_url": {
      "type": "string",
      "description": "URL do contrato anexado pelo coordenador para este período"
    },
    "numero_nf": {
      "type": "string",
      "description": "Número da nota fiscal"
    },
    "valor_nf": {
      "type": "number",
      "description": "Valor da nota fiscal"
    },
    "numero_parcela": {
      "type": "number",
      "description": "Qual parcela (1, 2, 3...)"
    },
    "valor_parcela_previsto": {
      "type": "number",
      "description": "Valor previsto da parcela"
    },
    "valor_pago": {
      "type": "number",
      "description": "Valor efetivamente pago quando o status for PAGO"
    },
    "descricao_nf_modelo": {
      "type": "string",
      "description": "Descrição modelo/orientação usada para conferência da nota"
    },
    "nf_numero_extraido": {
      "type": "string",
      "description": "Número da NF extraído automaticamente via IA"
    },
    "nf_valor_extraido": {
      "type": "number",
      "description": "Valor total extraído da NF via IA"
    },
    "nf_cnpj_emitente": {
      "type": "string",
      "description": "CNPJ do emitente extraído via IA"
    },
    "nf_razao_social": {
      "type": "string",
      "description": "Razão social do emitente extraída via IA"
    },
    "nf_data_emissao": {
      "type": "string",
      "description": "Data de emissão da NF extraída via IA"
    },
    "nf_competencia": {
      "type": "string",
      "description": "Competência/mês identificado na NF via IA"
    },
    "conformidade_percentual": {
      "type": "number",
      "description": "% de conformidade calculado pela IA (0-100)"
    },
    "conformidade_status": {
      "type": "string",
      "enum": [
        "CONFORME",
        "ATENCAO",
        "CRITICO"
      ],
      "description": "Status geral da análise de conformidade"
    },
    "conformidade_resumo": {
      "type": "string",
      "description": "Resumo da análise IA para o aprovador"
    },
    "conformidade_checklist": {
      "type": "string",
      "description": "JSON com checklist detalhado da análise"
    },
    "conformidade_duvidas": {
      "type": "string",
      "description": "JSON com lista de dúvidas apontadas pela IA"
    },
    "analysis_status": {
      "type": "string",
      "description": "Status resumido da análise automática"
    },
    "analysis_summary": {
      "type": "string",
      "description": "Resumo da análise automática"
    },
    "analysis_warnings": {
      "type": "string",
      "description": "JSON com alertas da análise automática"
    },
    "analysis_critical_issues": {
      "type": "string",
      "description": "JSON com inconsistências críticas da análise automática"
    },
    "resultado_validacao": {
      "type": "string",
      "description": "JSON bruto do resultado da validação/análise"
    },
    "aprovador_ciente_duvidas": {
      "type": "boolean",
      "default": false,
      "description": "Aprovador confirmou ciência das dúvidas antes de aprovar"
    },
    "status": {
      "type": "string",
      "enum": [
        "RASCUNHO",
        "AGUARDANDO_APROVACAO",
        "EM_ANALISE_COORD",
        "DEVOLVIDO_REVISAO",
        "APROVADO_COORD",
        "ENCAMINHADO_COORD_ADMIN",
        "APROVADO",
        "REVISAO",
        "PAGO",
        "RECUSADO",
        "FINALIZADO"
      ],
      "default": "RASCUNHO",
      "description": "Status do pagamento no fluxo"
    },
    "aprov_coord_email": {
      "type": "string",
      "description": "Email do aprovador coordenador"
    },
    "aprov_coord_nome": {
      "type": "string",
      "description": "Nome do aprovador coordenador"
    },
    "aprov_coord_data": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora da aprovação da coordenação"
    },
    "aprov_admin_email": {
      "type": "string",
      "description": "Email do aprovador administrativo"
    },
    "aprov_admin_nome": {
      "type": "string",
      "description": "Nome do aprovador administrativo"
    },
    "data_pagamento": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora do pagamento"
    },
    "comprovante_url": {
      "type": "string",
      "description": "URL do comprovante de pagamento"
    },
    "observacoes": {
      "type": "string",
      "description": "Observações gerais do fluxo"
    },
    "unique_key": {
      "type": "string",
      "description": "Chave única lógica por usuário + competência"
    }
  },
  "required": [
    "team_member_id",
    "user_email",
    "mes_referencia",
    "ano",
    "nota_fiscal_url",
    "rubrica_id",
    "rubrica_nome"
  ]
}
