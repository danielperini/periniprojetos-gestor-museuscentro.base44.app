{
  "name": "NotificationLog",
  "type": "object",
  "properties": {
    "notification_id": {
      "type": "string",
      "description": "ID da notifica\u00e7\u00e3o"
    },
    "user_email": {
      "type": "string",
      "description": "Email do usu\u00e1rio"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "sent",
        "read",
        "clicked",
        "archived",
        "pinned",
        "email_sent",
        "email_failed",
        "unsubscribed",
        "resubscribed"
      ],
      "description": "Tipo de evento"
    },
    "category": {
      "type": "string",
      "description": "Categoria da notifica\u00e7\u00e3o"
    },
    "priority": {
      "type": "string",
      "description": "Prioridade da notifica\u00e7\u00e3o"
    },
    "delivery_method": {
      "type": "string",
      "enum": [
        "in_app",
        "email",
        "push"
      ],
      "description": "M\u00e9todo de entrega"
    },
    "status": {
      "type": "string",
      "enum": [
        "success",
        "failed",
        "pending"
      ],
      "description": "Status do evento"
    },
    "error_message": {
      "type": "string",
      "description": "Mensagem de erro (se houver)"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "notification_id",
    "user_email",
    "event_type"
  ]
}