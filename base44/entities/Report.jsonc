{
  "name": "Report",
  "type": "object",
  "properties": {
    "numero_protocolo": {
      "type": "string",
      "description": "N\u00famero de protocolo \u00fanico do relat\u00f3rio no formato MC-MESANO-XXXXX"
    },
    "author_name": {
      "type": "string",
      "description": "Nome do profissional"
    },
    "author_role": {
      "type": "string",
      "enum": [
        "COORDENADOR",
        "PROFISSIONAL",
        "ADMIN"
      ],
      "description": "Papel do autor"
    },
    "funcao": {
      "type": "string",
      "description": "Fun\u00e7\u00e3o do profissional"
    },
    "museu": {
      "type": "string",
      "description": "Museu principal"
    },
    "museu_secundario": {
      "type": "string",
      "description": "Museu secund\u00e1rio (opcional)"
    },
    "equipe": {
      "type": "string",
      "description": "Equipe do profissional"
    },
    "mes_referencia": {
      "type": "string",
      "enum": [
        "Janeiro",
        "Fevereiro",
        "Mar\u00e7o",
        "Abril",
        "Maio",
        "Junho",
        "Julho",
        "Agosto",
        "Setembro",
        "Outubro",
        "Novembro",
        "Dezembro"
      ],
      "description": "M\u00eas de refer\u00eancia"
    },
    "ano": {
      "type": "number",
      "default": 2026,
      "description": "Ano de refer\u00eancia"
    },
    "publico_geral_declarado": {
      "type": "number",
      "default": 0,
      "description": "P\u00fablico geral declarado do museu no per\u00edodo (circula\u00e7\u00e3o total / visitantes gerais). N\u00c3O entra na soma de atividades, eventos ou forma\u00e7\u00f5es. Exibido separadamente nos dashboards."
    },
    "resumo_periodo": {
      "type": "string",
      "description": "Resumo ou apresenta\u00e7\u00e3o do per\u00edodo"
    },
    "resumo_executivo": {
      "type": "string",
      "description": "Resumo executivo do m\u00eas"
    },
    "avaliacao_pontos_positivos": {
      "type": "string",
      "description": "Pontos positivos do m\u00eas"
    },
    "avaliacao_desafios": {
      "type": "string",
      "description": "Desafios enfrentados"
    },
    "avaliacao_sugestoes": {
      "type": "string",
      "description": "Sugest\u00f5es de melhoria"
    },
    "comentarios_gerais": {
      "type": "string",
      "description": "Coment\u00e1rios gerais do relat\u00f3rio"
    },
    "comentarios_coordenacao": {
      "type": "string",
      "description": "Coment\u00e1rios para a coordena\u00e7\u00e3o"
    },
    "historico_observacoes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es de hist\u00f3rico"
    },
    "oportunidades_resumo": {
      "type": "string",
      "description": "Resumo de oportunidades identificadas"
    },
    "status": {
      "type": "string",
      "enum": [
        "DRAFT",
        "SUBMITTED",
        "IN_REVIEW",
        "RETURNED",
        "APPROVED",
        "ARCHIVED"
      ],
      "default": "DRAFT",
      "description": "Status do relat\u00f3rio no workflow"
    },
    "review_status": {
      "type": "string",
      "enum": [
        "aguardando_revisao",
        "revisao_concluida",
        "aguardando_aprovacao_final"
      ],
      "default": "aguardando_revisao",
      "description": "Status granular da revis\u00e3o"
    },
    "return_comment": {
      "type": "string",
      "description": "Coment\u00e1rio de devolu\u00e7\u00e3o pelo coordenador"
    },
    "reviewer_email": {
      "type": "string",
      "description": "Email do coordenador respons\u00e1vel pela revis\u00e3o"
    },
    "reviewer_name": {
      "type": "string",
      "description": "Nome do coordenador respons\u00e1vel pela revis\u00e3o"
    },
    "delegated_to_email": {
      "type": "string",
      "description": "Email do coordenador para o qual a revis\u00e3o foi delegada"
    },
    "delegated_to_name": {
      "type": "string",
      "description": "Nome do coordenador para o qual a revis\u00e3o foi delegada"
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora do envio para revis\u00e3o"
    },
    "drive_file_id": {
      "type": "string",
      "description": "ID do arquivo PDF exportado no Google Drive"
    },
    "drive_file_url": {
      "type": "string",
      "description": "URL do arquivo PDF no Google Drive"
    },
    "exported_pdf_url": {
      "type": "string",
      "description": "URL p\u00fablica do PDF exportado"
    },
    "exported_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora da exporta\u00e7\u00e3o para Drive"
    },
    "export_status": {
      "type": "string",
      "enum": [
        "EXPORTANDO",
        "EXPORTADO",
        "BACKUP_OK",
        "ERRO_BACKUP"
      ],
      "default": "EXPORTANDO",
      "description": "Status da exporta\u00e7\u00e3o para Drive"
    },
    "atividades": {
      "type": "array",
      "description": "Lista de atividades executadas no m\u00eas",
      "items": {
        "type": "object"
      }
    },
    "oportunidades": {
      "type": "array",
      "description": "Oportunidades identificadas no m\u00eas",
      "items": {
        "type": "object"
      }
    },
    "fotos": {
      "type": "array",
      "description": "Fotos vinculadas ao relat\u00f3rio",
      "items": {
        "type": "object"
      }
    },
    "depoimentos": {
      "type": "array",
      "description": "Depoimentos ou fatos marcantes do m\u00eas (m\u00e1x 5)",
      "items": {
        "type": "object",
        "properties": {
          "texto": {
            "type": "string"
          },
          "autor": {
            "type": "string"
          },
          "data_criacao": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "author_name",
    "museu",
    "mes_referencia",
    "ano",
    "status"
  ],
  "rls": {}
}